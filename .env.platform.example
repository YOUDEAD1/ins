# Add to the EXISTING NSS .env. Keep its TOKEN, MONGO_URI and database name.
# This public username alone enables the link to the separate STORE-MANAGER bot.
WWC_MANAGER_USERNAME=""

# Optional LEGACY platform/checkout recovery; retain existing values if already in use.
# URL can point to STORE-MANAGER's HTTPS origin, with the same PLATFORM_SECRET.
WWC_PLATFORM_URL=""
WWC_PLATFORM_SECRET=""
WWC_DRAFT_ENCRYPTION_KEY=""
WWC_PLATFORM_OWNERS=""
# NSS keeps its existing TOKEN, OWNER_ID, MONGO_URI and database name.
# APP_URL / the server URL must be the public HTTPS origin of NSS.
