+_EXT_LIGHT_PROJ = {'desc': 0, 'desc_text': 0, 'desc_ar': 0, 'desc_en': 0, 'desc_ar_html': 0, 'desc_en_html': 0}
+_SHOP_SQ = {}          # uid → اقتراحات «هل تقصد» (الأزرار تحمل رقم بس)
