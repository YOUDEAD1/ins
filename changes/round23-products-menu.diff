+class Links(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.urls, self.depth = [], 0
+    def handle_starttag(self, tag, attrs):
+        if tag == 'a':
+            assert self.depth == 0
+            self.depth += 1
+            self.urls.append(dict(attrs)['href'])
+    def handle_endtag(self, tag):
+        if tag == 'a':
+            self.depth -= 1
+            assert self.depth == 0
+
