+    class StopLoop(Exception):
+        pass
+    monkeypatch.setattr(mod._REF_SCAN_WAKE, 'wait', Mock(side_effect=StopLoop))
+    with pytest.raises(StopLoop):
+        mod.background_referral_checker_v2()
