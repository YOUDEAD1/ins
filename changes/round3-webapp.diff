+}
+/* احتياطي للإيموجي المتحرك: ألوان الطبقات من ملف الحركة نفسه */
+function ecFromLottie(json) {
+  const cols = [];
+  const walk = o => {
+    if (!o || typeof o !== 'object') return;
+    if (Array.isArray(o)) { o.forEach(walk); return; }
+    if ((o.ty === 'fl' || o.ty === 'st') && o.c && o.c.k) {
+      const k = o.c.k, v = Array.isArray(k) && typeof k[0] === 'number' ? k : (Array.isArray(k) && k[0] && k[0].s) || null;
+      if (v && v.length >= 3) cols.push(v);
+    }
+    if ((o.ty === 'gf' || o.ty === 'gs') && o.g && o.g.k) {
+      const n = o.g.p || 0, k = Array.isArray(o.g.k.k) ? o.g.k.k : (o.g.k.k && o.g.k.k[0] && o.g.k.k[0].s) || [];
+      for (let i = 0; i < n; i++) if (k.length >= i * 4 + 4) cols.push([k[i * 4 + 1], k[i * 4 + 2], k[i * 4 + 3]]);
+    }
