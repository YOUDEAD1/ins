+}
+async function ecSample(el) {
+  const m = el.querySelector('svg,video,img'); if (!m) return null;
+  const Z = 48, cv = document.createElement('canvas'); cv.width = cv.height = Z;
+  const cx = cv.getContext('2d', { willReadFrequently: true });
+  if (m.tagName.toLowerCase() === 'svg') {
+    const cl = m.cloneNode(true);
+    cl.setAttribute('width', Z); cl.setAttribute('height', Z); cl.removeAttribute('style');
+    if (!cl.getAttribute('xmlns')) cl.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
+    const url = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(cl)], { type: 'image/svg+xml' }));
+    try {
+      const im = new Image();
+      await new Promise((ok, no) => { im.onload = ok; im.onerror = no; im.src = url; });
+      cx.drawImage(im, 0, 0, Z, Z);
+    } finally { URL.revokeObjectURL(url); }
