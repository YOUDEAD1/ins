+  const S = (r, g, b) => `${Math.round(Math.min(1, Math.max(0, r)) * 255)} ${Math.round(Math.min(1, Math.max(0, g)) * 255)} ${Math.round(Math.min(1, Math.max(0, b)) * 255)}`;
+  if (tw < aw * .05) {                       // إيموجي أبيض/أسود/رمادي: خلفية محايدة تبيّنه
+    let r = ar / aw, g = ag / aw, b = ab / aw; const L = .2126 * r + .7152 * g + .0722 * b;
+    if (L > .62) { r = .22; g = .26; b = .34; } else if (L < .3) { r = .58; g = .63; b = .72; }
+    return [S(r, g, b), S(r * .78, g * .8, b * .86)];
+  }
+  const sc = bins.map((B, k) => B.w + .45 * (bins[(k + N - 1) % N].w + bins[(k + 1) % N].w));
+  const ord = sc.map((v, k) => [v, k]).sort((x, y) => y[0] - x[0]);
+  const avg = k => { let w = 0, r = 0, g = 0, b = 0; for (const j of [k, (k + 1) % N, (k + N - 1) % N]) { const B = bins[j]; w += B.w; r += B.r; g += B.g; b += B.b; } return [r / w, g / w, b / w]; };
+  const k1 = ord[0][1], c1 = avg(k1);
