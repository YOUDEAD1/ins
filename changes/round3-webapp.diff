+  const px = new Uint8ClampedArray(cols.length * 4);
+  cols.forEach((c, i) => { px[i * 4] = c[0] * 255; px[i * 4 + 1] = c[1] * 255; px[i * 4 + 2] = c[2] * 255; px[i * 4 + 3] = 255; });
