+/* يختار لونين من بكسلات الإيموجي: اللون الأكثر حضوراً (الحيوي أولاً) ولون ثاني مختلف عنه */
+function ecPick(px) {
+  const N = 24, bins = Array.from({ length: N }, () => ({ w: 0, r: 0, g: 0, b: 0 }));
