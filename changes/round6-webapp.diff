+.vf{max-width:440px;margin:0 auto;padding:14px 0 28px;display:flex;flex-direction:column;gap:16px}
+.vf-hero{display:flex;flex-direction:column;align-items:center;text-align:center;gap:8px}
+.vf-shield{position:relative;width:80px;height:80px;display:grid;place-items:center;margin-top:4px}
+.vf-shield::before{content:"";position:absolute;inset:-16px;border-radius:50%;background:radial-gradient(circle,var(--accent-soft) 0,transparent 70%);animation:vfPulse 2.8s ease-in-out infinite}
