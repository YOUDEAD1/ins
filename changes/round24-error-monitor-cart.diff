+function reportClientError(message,locationText,operation) {
+  if(DEMO||!INIT||Date.now()-clientErrorAt<5000)return;
+  clientErrorAt=Date.now();
+  fetch(API+'/webapp/client/error',{method:'POST',headers:{'Content-Type':'application/json','X-Telegram-Init-Data':INIT},
