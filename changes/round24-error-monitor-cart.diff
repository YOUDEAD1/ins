+  if (act==='cart-funds') { openFunds(Math.max(1,+el.dataset.v||1));return true; }
+  if (act==='cart-edit'||act==='cart-remaining') {
+    if(S.cartPending) {
+      const r=await api('cart/cancel',{checkout_id:S.cartPending.id});
+      if(!r.ok){toast(errText(r),'bad');return true;}
+      if(r.status!=='cancelled'){cartApplyReceipt(r);st.receipt=r;st.stage='receipt';renderCart(sh,st);return true;}
+      cartApplyReceipt(r);
