+def _chbc_load(token, uid):
+    if not _is_admin_check(uid) or not re.fullmatch(r'[a-f0-9]{24}', str(token)):
+        return None
+    return db.channel_broadcasts.find_one({'_id': token, 'owner_id': uid, 'session_until': {'$gt': time.time()}})
