+        key = {'_id': doc['_id']} if doc.get('_id') is not None else {'user_id': doc.get('user_id')}
+        r = coll.update_one(dict(key, balance=b), {'$set': {'balance': c}})
+        if getattr(r, 'modified_count', 0):
+            doc['balance'] = c
