+.ds-hint button{color:var(--accent);font-weight:700}
+.ds-line{padding:14px;border-radius:16px;background:var(--surface-2);border:1px dashed var(--line-2)}
+.ds-line .l{font-size:12px;color:var(--fg-2);display:flex;justify-content:space-between;align-items:center;gap:8px}
+.ds-line .v{margin-top:6px;font:600 15px/1.5 var(--f-mono);direction:ltr;text-align:left;overflow-wrap:anywhere;user-select:all}
+.ds-parts{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
+.ds-part{display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:6px 6px 6px 10px;border-radius:10px;background:var(--surface);border:1px solid var(--line);font:12.5px/1.3 var(--f-mono);direction:ltr}
+.ds-part span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}
+.ds-part .copy{width:26px;height:26px;flex:none}
+.ds-warn{margin-top:10px;padding:10px 12px;border-radius:12px;background:var(--bad-soft);color:var(--bad);font-size:13px;font-weight:650;line-height:1.5}
