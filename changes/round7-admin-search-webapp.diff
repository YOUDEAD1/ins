+.ds-tag{display:inline-block;padding:1px 7px;border-radius:7px;font-size:10.5px;font-weight:700;margin-inline-end:5px;vertical-align:1px}
+.ds-tag.in_stock{background:var(--ok-soft);color:var(--ok)}.ds-tag.reserved{background:var(--warn-soft);color:var(--warn)}
