+  await page.waitForTimeout(800);
+  const own=reports.find(r=>r.message==='Store render failed');
+  assert(own&&/__ref_test__/.test(own.location)&&own.build==='lara-34.1',JSON.stringify(reports));
+  console.log('PASS the store\'s own error is still reported with its location and build lara-34.1');
