+"""Round 34: a referral reward for a referrer with a negative balance is held (not lost, no error alert);
+timed deletes of an already-deleted message stay quiet; browser-extension errors are not store errors."""
+import types
+from unittest.mock import Mock
+
+import pytest
+from telebot.apihelper import ApiTelegramException
+
+from harness import MESSAGES
+from test_integration import mod, isolate, server, request, APP  # noqa: F401  (shared fixtures)
+from test_error_monitor import empty_monitor  # noqa: F401
+from test_referral_integrity import referral
+
+
+def _tg_400(description):
+    return ApiTelegramException('deleteMessage', types.SimpleNamespace(status_code=400),
+                                {'ok': False, 'error_code': 400, 'description': description})
+
+
+def _alerts(mod):
+    mod._error_drain()
+    return list(mod.db.system_errors.find({'level': {'$in': ['ERROR', 'CRITICAL']}}))
+
+
+def _bal(mod, uid=1001):
+    return mod.db.users.find_one({'user_id': uid})['balance']
+
+
+def test_negative_referrer_balance_holds_the_reward_without_an_error_alert(mod, monkeypatch):
+    referral(mod)
+    mod.db.users.update_one({'user_id': 1001}, {'$set': {'balance': -.4}})
+    notices = Mock()
+    monkeypatch.setattr(mod, 'notify_admins', notices)
+    reward = mod.get_referral_purchase_reward()
+    assert mod.award_purchase_referral_reward(5001, 'Netflix', 10) is False
+    assert mod.award_purchase_referral_reward(5001, 'Spotify', 12) is False
+    assert _alerts(mod) == []                                          # the old ERROR alert is gone
+    held = list(mod.db.ref_money_events.find({'kind': 'ref_purchase'}))
+    assert len(held) == 2 and all(e['status'] == 'prepared' and e['held'] and e['buyer_id'] == 5001 for e in held)
+    assert {e['product'] for e in held} == {'Netflix', 'Spotify'}
+    assert _bal(mod) == -.4                                            # update-29 protection still holds
+    assert notices.call_count == 1 and '/refwhy 1001' in notices.call_args.args[0]   # one notice a day
+    mod._ref_resume_financial()                                        # still negative → still waiting
+    assert _bal(mod) == -.4 and mod.db.purchase_rewards.count_documents({}) == 0
+    # the referrer tops up → the next minute's pass credits both rewards and records them once
+    mod.db.users.update_one({'user_id': 1001}, {'$set': {'balance': 1.0}})
+    sent = len(MESSAGES)
+    mod._ref_resume_financial()
+    mod._ref_resume_financial()
+    assert _bal(mod) == round(1.0 + 2 * reward, 6)
+    assert mod.db.purchase_rewards.count_documents({'referrer_id': 1001, 'buyer_id': 5001}) == 2
+    assert not mod.db.ref_money_events.count_documents({'held': True})
+    told = [m for m in MESSAGES[sent:] if m[0] == 1001]
+    assert len(told) == 2 and 'Referral reward added' in told[0][1]
+    assert _alerts(mod) == []
+
+
+def test_normal_referrer_reward_is_unchanged(mod):
+    referral(mod)
+    reward = mod.get_referral_purchase_reward()
+    assert mod.award_purchase_referral_reward(5001, 'Netflix', 10) is True
+    assert _bal(mod) == round(100 + reward, 6)
+    ev = mod.db.ref_money_events.find_one({'kind': 'ref_purchase'})
+    assert ev['status'] == 'applied' and 'held' not in ev
+    assert mod.db.purchase_rewards.count_documents({'ref_event': ev['_id']}) == 1
+    mod._ref_resume_financial()
+    assert mod.db.purchase_rewards.count_documents({}) == 1 and _bal(mod) == round(100 + reward, 6)
+
+
+def test_reward_saved_by_the_previous_version_is_recorded_once_credited(mod):
+    mod.db.users.update_one({'user_id': 1001}, {'$set': {'balance': -.4}})
+    with pytest.raises(ValueError):          # what the old award left behind: a saved movement, no record
+        mod._ref_money(1001, .1, 'ref_purchase', 'مكافأة شراء إحالة (5001)')
+    mod.db.ref_money_events.update_many({}, {'$inc': {'created_at': -600}})
+    mod._ref_resume_financial()
+    ev = mod.db.ref_money_events.find_one({})
+    assert ev['held'] and ev['held_reason'] == 'unrecorded' and ev['buyer_id'] == 5001
+    mod.db.users.update_one({'user_id': 1001}, {'$set': {'balance': 0.0}})
+    mod._ref_resume_financial()
+    mod._ref_resume_financial()
+    assert _bal(mod) == .1 and mod.db.purchase_rewards.count_documents({'buyer_id': 5001}) == 1
+
+
+def test_clawback_on_a_negative_balance_waits_quietly(mod, monkeypatch):
+    referral(mod, paid=True)
+    mod.db.users.update_one({'user_id': 1001}, {'$set': {'balance': -.4}})
+    notices = Mock()
+    monkeypatch.setattr(mod, 'notify_admins', notices)
+    mod.mark_referral_status(5001, 'left')
+    mod._ref_resume_financial()
+    assert mod._ref_find(5001)['cb_status'] == 'processing' and _bal(mod) == -.4
+    assert _alerts(mod) == [] and notices.call_count == 1
+    mod.db.users.update_one({'user_id': 1001}, {'$set': {'balance': .25}})
+    mod._ref_resume_financial()
+    assert mod._ref_find(5001)['cb_status'] == 'applied'
+    user = mod.db.users.find_one({'user_id': 1001})
+    assert user['balance'] == 0 and user['ref_debt'] == .75
+
