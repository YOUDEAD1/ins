+# ============================================================
+# ⏸ Update 29 forbids moving referral money while the referrer's balance is below zero (ledger review first).
+#    Before: a purchase reward for such a referrer raised an ERROR alert and the reward was never recorded.
+#    Now: the movement stays saved («prepared»), the financial resume loop retries it every minute, and it is
+#    credited automatically once the balance is ≥ 0 — then recorded in purchase_rewards and the referrer is told.
+#    Admins get one plain notice per referrer per day instead of an error alert.
+# ============================================================
+_REF_NEGATIVE_HOLD = 'Negative balance requires ledger review before referral movement'
+_REF_HOLD_NOTICE_EVERY = 86400
