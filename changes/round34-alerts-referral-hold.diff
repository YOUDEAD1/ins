+def _ref_hold_notice(rid, detail):
+    """One notice per referrer per day (atomic claim on _id); never an error alert."""
+    try:
+        rid, now = int(rid), int(time.time())
+        if rid <= 0:
+            return False
+        claimed = db.ref_hold_notices.update_one(
+            {'_id': rid, 'at': {'$lte': now - _REF_HOLD_NOTICE_EVERY}}, {'$set': {'at': now}}).modified_count
+        if not claimed:
+            try:
+                db.ref_hold_notices.insert_one({'_id': rid, 'at': now})
+            except Exception:
+                return False                      # already told today
+        bal = float((db.users.find_one({'user_id': rid}, {'balance': 1}) or {}).get('balance') or 0)
+        notify_admins(
+            "⏸ <b>حركة إحالة محفوظة بانتظار الرصيد</b>\n\n"
+            f"المُحيل: <code>{rid}</code> — رصيده الحالي <b>${bal:.4f}</b> (سالب).\n"
+            "حماية الإحالات تمنع أي حركة على رصيد سالب قبل مراجعته، فما تنفذت الحين.\n"
+            f"{detail}\n\n"
+            "✅ ما ضاعت: محفوظة وتتنفذ تلقائيًا أول ما يرجع رصيده 0 أو أكثر (فحص كل دقيقة).\n"
+            f"🔎 للمراجعة: <code>/refwhy {rid}</code>\n"
+            "<i>هذا التنبيه مرة واحدة في اليوم لكل مُحيل.</i>")
+        return True
+    except Exception as e:
+        logger.debug(f"referral hold notice skipped: {e}")
+        return False
+
+
+def _ref_hold_purchase_reward(operation, rid, buyer_uid, product_name, purchase_amount, amount):
+    key = hashlib.sha256(str(operation).encode()).hexdigest()[:32]
+    try:
+        db.ref_money_events.update_one({'_id': key, 'status': 'prepared'}, {'$set': {
+            'held': True, 'held_reason': 'negative_balance', 'held_at': int(time.time()),
+            'buyer_id': int(buyer_uid), 'product': str(product_name or '')[:200],
+            'purchase_amount': float(purchase_amount or 0)}})
+    except Exception as e:
+        logger.debug(f"held reward details not saved: {e}")
+    logger.info('Referral purchase reward held until the referrer balance is not negative: referrer=%s buyer=%s amount=%s',
+                rid, buyer_uid, amount)
+    product = f" ({html.escape(str(product_name)[:80])})" if product_name else ''
+    _ref_hold_notice(rid, f"العملية: مكافأة شراء <b>${float(amount):.2f}</b> من شراء <code>{int(buyer_uid)}</code>{product}.")
+
+
+def _ref_release_held_rewards(limit=50):
+    """Records a held purchase reward once the resume loop has credited it, and tells the referrer — exactly once.
+    Also adopts purchase rewards an older version saved but never recorded (same note format)."""
+    cutoff = int(time.time()) - 300                      # never touch an award that is still in progress
+    for ev in db.ref_money_events.find({'kind': 'ref_purchase', 'status': 'prepared', 'held': {'$exists': False},
+                                        'created_at': {'$lt': cutoff}}).limit(limit):
+        m = re.search(r'\((\d+)\)', str(ev.get('note') or ''))
+        db.ref_money_events.update_one({'_id': ev['_id'], 'held': {'$exists': False}}, {'$set': {
+            'held': True, 'held_reason': 'unrecorded', 'held_at': int(time.time()),
+            'buyer_id': int(m.group(1)) if m else None}})
+    released = 0
+    for ev in db.ref_money_events.find({'kind': 'ref_purchase', 'status': 'applied', 'held': True}).limit(limit):
+        if not db.ref_money_events.find_one_and_update({'_id': ev['_id'], 'held': True}, {'$set': {
+                'held': False, 'released_at': int(time.time())}}):
+            continue
+        rid, receipt, amount = int(ev['user_id']), ev.get('receipt') or {}, float(ev.get('amount') or 0)
+        db.purchase_rewards.update_one({'ref_event': ev['_id']}, {'$setOnInsert': {
+            'referrer_id': rid, 'buyer_id': ev.get('buyer_id'), 'amount': amount,
+            'balance_credited': receipt.get('balance_delta', 0), 'debt_settled': -receipt.get('debt_delta', 0),
+            'product': ev.get('product', ''), 'purchase_amount': ev.get('purchase_amount'),
+            'held_since': ev.get('held_at') or ev.get('created_at'), 'timestamp': int(time.time())}}, upsert=True)
+        released += 1
+        logger.info('Held referral purchase reward credited: referrer=%s amount=%s', rid, amount)
+        try:
+            new_balance, settled = float(receipt.get('balance_after', 0)), -float(receipt.get('debt_delta', 0))
+            if get_lang(rid) == 'en':
+                text = (f"🎁 <b>Referral reward added</b>\n\n<b>${amount:.2f}</b> from a purchase by a customer you referred "
+                        f"was on hold while your balance was below zero. It has now been added.")
+                if settled > 0:
+                    text += f"\n${settled:.4f} of it settled earlier referral liabilities."
+                text += f"\nBalance: <b>${new_balance:.2f}</b>"
+            else:
+                text = (f"🎁 <b>انضافت مكافأة إحالة</b>\n\n<b>${amount:.2f}</b> من شراء عميل جاء عن طريقك كانت محفوظة "
+                        f"لأن رصيدك كان تحت الصفر، والحين انضافت.")
+                if settled > 0:
+                    text += f"\nمنها ${settled:.4f} سددت مستحقات إحالات سابقة."
+                text += f"\nرصيدك: <b>${new_balance:.2f}</b>"
+            bot.send_message(rid, text, parse_mode='HTML')
+        except Exception:
+            pass
+    return released
+
