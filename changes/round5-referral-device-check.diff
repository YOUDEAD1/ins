+def _refdv_decide(call, verdict):
+    try:
+        uid = int(call.data.rsplit('_', 1)[1])
+    except Exception:
+        return
+    rec = db.referrals_v2.find_one({'invited_id': uid})
+    if not rec:
+        bot.answer_callback_query(call.id, "الإحالة ما عادت موجودة.", show_alert=True)
+        return
+    who = html.escape(clean_name(call.from_user.first_name or str(call.from_user.id)))
+    if verdict == 'ok':
+        db.referrals_v2.update_one({'invited_id': uid}, {'$set': {'dv': 'ok_admin', 'dv_by': call.from_user.id}})
+        try:
+            _FORCED_SUB_CACHE.pop(uid, None)
+        except Exception:
+            pass
+        if check_forced_sub(uid):
+            mark_referral_status(uid, 'active')
+            note = f"✅ <b>انحسبت</b> للمحيل (بواسطة {who})."
+        else:
