+        act, tot = 0, 0
+    inf = res['info']
+    dev = {'android': 'أندرويد', 'android_x': 'أندرويد', 'ios': 'آيفون', 'tdesktop': 'تيليجرام ديسكتوب', 'macos': 'ماك',
+           'weba': 'تيليجرام ويب', 'webk': 'تيليجرام ويب', 'web': 'تيليجرام ويب', 'unigram': 'Unigram'}.get(inf['tgp'], inf['tgp'])
+    lines = ["⚠️ <b>إحالة مشكوك فيها — موقوفة لين تقرر</b>", "",
+             f"👤 المدعو: {_dv_user_line(uid)}",
+             f"🤝 المحيل: {_dv_user_line(rid)} · إحالاته النشطة {act} من {tot}",
+             f"📱 الجهاز: {html.escape(dev)}" + (f" · <code>{html.escape(inf['gl'][:60])}</code>" if inf.get('gl') else '')]
+    if others:
+        lines += ["", f"🔁 <b>نفس الجهاز انستخدم قبل لـ {len(others)} حساب:</b>"]
+        lines += [f"• {_dv_user_line(o, rid)}" for o in others[:8]]
+        if len(others) > 8:
+            lines.append(f"… و{len(others) - 8} حساب ثاني")
+        if res['strong']:
+            lines.append("<i>تطابق مؤكد: نفس الجهاز ونفس تطبيق تيليجرام.</i>")
+        else:
+            lines.append("<i>تطابق محتمل: نفس بصمة الجهاز بالضبط.</i>")
+    if res['reasons']:
+        lines += ["", "🧪 <b>فحص الجهاز:</b> " + html.escape('، '.join(res['reasons']))]
+    else:
+        lines += ["", "🧪 <b>فحص الجهاز:</b> يبدو جهاز حقيقي"]
+    lines += ["", "<i>الإحالة ما تنحسب للمحيل إلا لو ضغطت «احسبها».</i>"]
+    buttons = [['cb', '✅ احسبها', f'refdv_ok_{uid}'], ['cb', '❌ لا تحسبها', f'refdv_no_{uid}'],
+               ['cb', '🚫 حظر المدعو', f'refdv_ban_{uid}']]
+    if rid:
+        buttons.append(['cb', '📂 ملف المحيل', f'ad_u_det_{rid}'])
+    try:
+        notify_admins('\n'.join(lines), buttons=buttons)
+    except Exception as e:
+        logger.warning(f"dv admin alert failed: {e}")
+
+
+def _dv_user_done(uid):
+    lang = get_lang(uid)
+    kb = types.InlineKeyboardMarkup()
+    try:
+        url = _wa_public_url()
+        if url:
