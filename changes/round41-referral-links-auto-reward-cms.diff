+    assert [m for m in new if 'صُرفت مكافأة إحالات تلقائيًا' in str(m[1])]             # the admin gets the report
+    mod._ref_resume_financial()
+    assert mod.db.users.find_one({'user_id': 1001})['balance'] == round(100 + reward, 6)   # never twice
