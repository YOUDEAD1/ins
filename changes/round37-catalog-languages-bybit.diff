+    mod._ref_purchase_dm(1001, 1002, 1, 101)
+    assert_language(dm(), 'en')
+    MESSAGES.clear()
+    mod.db.custom_texts.insert_one({'lang': 'en', 'key': 'ref_purchase_dm', 'value': 'CUSTOM REWARD ${1} BALANCE ${2}'})
+    mod._ref_purchase_dm(1001, 1002, 1, 101)
+    assert 'CUSTOM REWARD $1.00 BALANCE $101.00' in dm()
+
+
