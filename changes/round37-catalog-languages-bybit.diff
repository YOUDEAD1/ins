+
+
+def test_sweep_reads_only_grouped_stock_ids_not_product_bodies_or_provider_http(mod, monkeypatch):
+    product(mod, stock=0)
+    monkeypatch.setattr(mod.db.products, 'find', Mock(side_effect=AssertionError('full product download')))
